# ============================================
# Interviewmate Environment Configuration
# ============================================
# Copy this file to .env and fill in the values
# ============================================

# --------------------------------------------
# Backend Environment Variables
# --------------------------------------------

# Server Configuration
NODE_ENV=development
PORT=5000

# MongoDB Database Connection
# Get this from MongoDB Atlas or your MongoDB instance
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/<database>?retryWrites=true&w=majority

# JWT Authentication
# Use a long, random secret string — e.g. generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d

# Vapi AI Integration (Backend)
# Get your Vapi API key from: https://app.vapi.ai/
VAPI_PUBLIC_KEY=...

# OpenRouter AI (used for interview transcript analysis via InterviewResponseAnalyzer)
# Get your API key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-...


# --------------------------------------------
# Frontend Environment Variables
# --------------------------------------------

# Backend API URL
# Use this for local development:
VITE_BACKEND_URL=http://localhost:5000
# Or for production deployment (uncomment and update):
# VITE_BACKEND_URL=https://your-backend-domain.com

# Vapi AI Integration (Frontend)
# Get your Vapi public key from: https://app.vapi.ai/
VITE_VAPI_PUBLIC_KEY=...

# --------------------------------------------
# Optional: Additional Configuration
# --------------------------------------------

# MongoDB Debug Logging (optional - set to 'true' to enable)
# MONGODB_LOG_COMMAND=true
# MONGODB_LOG_TOPOLOGY=true